# AIOps Sentinel — Environment Configuration
# Copy this file to .env and fill in your values

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=changeme_in_production

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080

# Dashboard
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ML model paths
MODEL_PATH=ml/models/isolation_forest.joblib
SCALER_PATH=ml/models/scaler.joblib

# Collector settings
COLLECTOR_INTERVAL_SEC=5
COLLECTOR_TARGET_URL=http://localhost:8080/api/v1/metrics

# Alert engine
ANOMALY_THRESHOLD=-0.15
ALERT_COOLDOWN_SEC=120
MIN_CONSECUTIVE_ANOMALIES=2
